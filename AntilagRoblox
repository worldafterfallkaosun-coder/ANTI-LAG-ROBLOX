-- DRAG — FIXED, ISOLATED, DEADZONE
-- ================================================
local dragActive = false
local dragStart  = nil
local dragOrigin = nil
local DEADZONE   = 8

header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        -- pastiin bukan dari toggleBtn
        dragStart  = input.Position
        dragOrigin = main.Position
        dragActive = false
    end
end)

header.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragActive = false; dragStart = nil
    end
end)

trackConn(UserInputService.InputChanged:Connect(function(input)
    -- SLIDER CAP
    if getCapDrag() then
        if input.UserInputType==Enum.UserInputType.MouseMovement
        or input.UserInputType==Enum.UserInputType.Touch then
            local v = setCapVal(capPosToVal(input.Position.X))
            fpsCapValue = v
            pcall(function() if HAS_SETFPSCAP then setfpscap(v) end end)
        end
        return
    end
    -- SLIDER RD
    if getRDDrag() then
        if input.UserInputType==Enum.UserInputType.MouseMovement
        or input.UserInputType==Enum.UserInputType.Touch then
            local v = setRDVal(rdPosToVal(input.Position.X))
            renderDist = v
        end
        return
    end
    -- DRAG
    if dragStart then
        if input.UserInputType==Enum.UserInputType.MouseMovement
        or input.UserInputType==Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            if not dragActive and
               (math.abs(delta.X) > DEADZONE or math.abs(delta.Y) > DEADZONE) then
                dragActive = true
            end
            if dragActive and dragOrigin then
                main.Position = UDim2.new(
                    dragOrigin.X.Scale, dragOrigin.X.Offset + delta.X,
                    dragOrigin.Y.Scale, dragOrigin.Y.Offset + delta.Y
                )
            end
        end
    end
end))

trackConn(UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.MouseButton1
    or input.UserInputType==Enum.UserInputType.Touch then
        dragActive=false; dragStart=nil
        setCapDrag(false); setRDDrag(false)
    end
end))


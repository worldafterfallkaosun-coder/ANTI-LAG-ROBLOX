local function trySetFPSCap(fps)
    -- Method 1: setfpscap (Delta, Synapse, etc)
    if setfpscap then
        pcall(setfpscap, fps)
        return "setfpscap(" .. fps .. ")"
    end
    -- Method 2: via settings hidden
    pcall(function()
        settings().Rendering.FrameRateManager = Enum.FrameRateManagerMode.Off
    end)
    return "fallback"
end

local function trySetHidden(obj, prop, val)
    if sethiddenproperty then
        pcall(sethiddenproperty, obj, prop, val)
    end
end

local function trySetRenderProperty(prop, val)
    if setrenderproperty then
        pcall(setrenderproperty, prop, val)
    end
end


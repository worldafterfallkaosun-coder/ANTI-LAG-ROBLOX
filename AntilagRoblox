local MIN_FPS, MAX_FPS = 30, 300
local capDragging = false

local function setCapValue(val)
    val = math.clamp(math.floor(val / 5) * 5, MIN_FPS, MAX_FPS) -- snap to multiples of 5
    fpsCapValue = val
    local pct = (val - MIN_FPS) / (MAX_FPS - MIN_FPS)
    capFill.Size     = UDim2.new(pct, 0, 1, 0)
    capThumb.Position = UDim2.new(pct, 0, 0.5, 0)
    capValLbl.Text   = tostring(val)
    -- apply langsung
    pcall(function() if setfpscap then setfpscap(val) end end)
end

capThumb.MouseButton1Down:Connect(function() capDragging = true end)
capTrack.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
    or i.UserInputType == Enum.UserInputType.Touch then
        capDragging = true
        local abs = capTrack.AbsolutePosition
        local sz  = capTrack.AbsoluteSize
        local pct = math.clamp((i.Position.X - abs.X) / sz.X, 0, 1)
        setCapValue(MIN_FPS + pct * (MAX_FPS - MIN_FPS))
    end
end)


local leafKW = {
    "leaf","leaves","daun","foliage","tree","pohon","bush","shrub",
    "grass","rumput","plant","tanaman","bark","branch","vine","fern"
}
local function isLeaf(name)
    name = name:lower()
    for _, k in ipairs(leafKW) do
        if name:find(k, 1, true) then return true end
    end
    return false
end

-- ================================================
-- CORE NUKE OBJECT — setiap kelas di-handle
-- ================================================
local function nukeObject(obj)
    pcall(function()

        -- [1] PBR TEXTURE KILLER — ini yg paling mahal di GPU
        if obj:IsA("SurfaceAppearance") or obj:IsA("MaterialVariant") then
            obj:Destroy(); return
        end

        -- [2] LIGHT SOURCES — tiap PointLight/SpotLight hit GPU shadow pass
        if CFG.lightKill and (
            obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight")
        ) then
            obj.Enabled = false  -- disable > destroy (safer)
            return
        end

        -- [3] PHYSICS CONSTRAINTS — setiap constraint = physics solver iteration
        if CFG.constraintKill and (
            obj:IsA("SpringConstraint") or obj:IsA("RopeConstraint") or
            obj:IsA("RodConstraint")    or obj:IsA("HingeConstraint") or
            obj:IsA("BallSocketConstraint") or obj:IsA("PrismaticConstraint") or
            obj:IsA("UniversalConstraint") or obj:IsA("CylindricalConstraint") or
            obj:IsA("TorsionSpringConstraint") or obj:IsA("PlaneConstraint") or
            obj:IsA("LineForce") or obj:IsA("VectorForce") or obj:IsA("BodyVelocity") or
            obj:IsA("BodyPosition") or obj:IsA("BodyForce") or obj:IsA("BodyGyro") or
            obj:IsA("BodyAngularVelocity")
        ) then
            obj:Destroy(); return
        end

        -- [4] SOUNDS — audio processing cost
        if CFG.soundKill and obj:IsA("Sound") then
            obj:Stop()
            obj.Volume = 0
            return
        end

        -- [5] BILLBOARD & SURFACE GUI — render pass overhead
        if CFG.guiKill and (obj:IsA("BillboardGui") or obj:IsA("SurfaceGui")) then
            obj.Enabled = false; return
        end

        -- [6] CLICK DETECTOR — input polling overhead
        if obj:IsA("ClickDetector") then
            obj.MaxActivationDistance = 0; return
        end

        -- [7] SELECTION DECORATORS
        if obj:IsA("SelectionBox") or obj:IsA("SelectionSphere") then
            obj:Destroy(); return
        end

        -- [8] EXPLOSION — bikin physics spike
        if obj:IsA("Explosion") then
            obj.BlastRadius = 0; return
        end

        -- [9] MESH — texture kill
        if obj:IsA("MeshPart") then
            if state.texture then
                obj.TextureID   = ""
                obj.Material    = Enum.Material.SmoothPlastic
                obj.Reflectance = 0
            end
            if state.shadow then obj.CastShadow = false end
            return
        end

        if obj:IsA("SpecialMesh") then
            if state.texture then obj.TextureId = "" end
            return
        end

        -- [10] BASE PART — main bulk
        if obj:IsA("BasePart") then
            if state.texture then
                obj.Material    = Enum.Material.SmoothPlastic
                obj.Reflectance = 0
            end
            if state.shadow then obj.CastShadow = false end

            if state.leaf and isLeaf(obj.Name) then
                obj.Transparency = 1
                obj.CanCollide   = false
                obj.CastShadow   = false
                return
            end

            if state.anchor then
                local isChar = false
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.Character and obj:IsDescendantOf(p.Character) then
                        isChar = true; break
                    end
                end
                if not isChar then
                    obj.Anchored = true
                    -- Network ownership: kalau anchored ga perlu sync ke server
                    if CFG.netOwn then
                        pcall(function() obj:SetNetworkOwner(nil) end)
                    end
                end
            end
            return
        end

        -- [11] DECAL / TEXTURE
        if obj:IsA("Decal") or obj:IsA("Texture") then
            if state.texture then obj.Transparency = 1 end
            return
        end

        -- [12] FX
        if state.fx and (
            obj:IsA("ParticleEmitter") or obj:IsA("Fire") or
            obj:IsA("Smoke")           or obj:IsA("Sparkles") or
            obj:IsA("Trail")           or obj:IsA("Beam")
        ) then
            obj:Destroy()
        end

        -- [13] NPC HUMANOID — disable expensive state machine
        if CFG.npcOptim and obj:IsA("Humanoid") then
            local isLocalChar = lp.Character and obj:IsDescendantOf(lp.Character)
            if not isLocalChar then
                pcall(function()
                    obj:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                    obj:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                    obj:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)
                    obj:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
                    obj:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
                    obj:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
                end)
            end
        end

    end)
end

-- ================================================
-- RENDER DISTANCE — ONE-SHOT
-- ================================================
local function applyRenderDistOnce()
    local char = lp.Character; if not char then return 0 end
    local root = char:FindFirstChild("HumanoidRootPart"); if not root then return 0 end
    local rp, n = root.Position, 0
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local isChar = false
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Character and obj:IsDescendantOf(p.Character) then
                    isChar = true; break
                end
            end
            if not isChar and (obj.Position-rp).Magnitude > renderDist then
                pcall(function() obj.Transparency = 1 end); n += 1
            end
        end
    end
    return n
end


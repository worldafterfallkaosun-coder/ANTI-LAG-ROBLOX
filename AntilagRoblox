        fpsBeforeVal.TextColor3 = fpsBaseline >= 50 and Color3.fromRGB(80,200,120)
            or fpsBaseline >= 30 and Color3.fromRGB(220,180,60)
            or Color3.fromRGB(200,80,60)
    end

    statusVal.Text      = "● RUNNING"
    statusVal.TextColor3 = Color3.fromRGB(255,180,0)
    applyBtn.Text        = "..."
    applyBtn.BackgroundColor3 = Color3.fromRGB(30,30,30)
    applyBtn.TextColor3       = Color3.fromRGB(0,220,110)

    task.spawn(function()

        -- LIGHTING
        if state.shadow then
            log("killing shadows...")
            pcall(function() Lighting.GlobalShadows = false end)
            for _, v in ipairs(Lighting:GetChildren()) do
                pcall(function()
                    if v:IsA("BlurEffect") or v:IsA("ColorCorrectionEffect")
                    or v:IsA("SunRaysEffect") or v:IsA("BloomEffect")
                    or v:IsA("DepthOfFieldEffect") or v:IsA("PostEffect") then
                        v:Destroy()
                    end
                end)
            end
        end

        -- ATMOSPHERE
        for _, v in ipairs(Lighting:GetChildren()) do
            pcall(function()
                if v:IsA("Atmosphere") then
                    v.Density = 0; v.Glare = 0; v.Haze = 0; v.Offset = 0
                end
            end)
        end

        -- SKY
        if state.sky then
            log("killing skybox...")
            for _, v in ipairs(Lighting:GetChildren()) do
                pcall(function()
                    if v:IsA("Sky") then v:Destroy() end
                end)
            end
        end

        -- TERRAIN (no Decoration — deprecated)
        pcall(function()
            local t = workspace:FindFirstChildOfClass("Terrain")
            if t then
                t.WaterWaveSize     = 0
                t.WaterWaveSpeed    = 0
                t.WaterReflectance  = 0
                t.WaterTransparency = 0
            end
        end)

        -- GRAPHICS QUALITY
        pcall(function()
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        end)

        -- MAIN SCAN — descendants
        log("scanning workspace...")
        local total = 0
        local descendants = workspace:GetDescendants()
        -- batch process: 300 obj per frame biar ga freeze
        local BATCH = 300
        for i = 1, #descendants, BATCH do
            for j = i, math.min(i + BATCH - 1, #descendants) do
                nukeObject(descendants[j])
                total = total + 1
            end
            task.wait() -- yield 1 frame per batch, preventing freeze
        end

        log("render dist " .. renderDist .. " studs...")
        local hidden = applyRenderDistOnce()

        task.wait(0.5)
        applied = true
        local afterFPS = getFPS()
        fpsAfterVal.Text = afterFPS .. " fps"
        fpsAfterVal.TextColor3 = afterFPS >= 50 and Color3.fromRGB(80,200,120)
            or afterFPS >= 30 and Color3.fromRGB(220,180,60)
            or Color3.fromRGB(200,80,60)

        log(total .. " obj nuked, " .. (hidden or 0) .. " hidden ✓")
        statusVal.Text       = "● ACTIVE"
        statusVal.TextColor3 = Color3.fromRGB(0,255,136)
        applyBtn.Text        = "⚡ RE-APPLY"
        applyBtn.BackgroundColor3 = Color3.fromRGB(0,220,110)
        applyBtn.TextColor3       = Color3.fromRGB(0,0,0)
    end)
end)

-- ================================================
-- LIVE LISTENER — ringan, hanya cek instance baru
-- ================================================
workspace.DescendantAdded:Connect(function(obj)
    if not applied then return end
    task.defer(function()  -- defer = lebih ringan dari task.wait()
        pcall(function() nukeObject(obj) end)
    end)
end)


-- WORLD NUKE
-- ================================================
local function nukeWorldObject(obj)
    pcall(function()
        if obj:IsA("SurfaceAppearance") or obj:IsA("MaterialVariant") then
            obj:Destroy(); return
        end
        if obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
            obj.Enabled = false; return
        end
        if obj:IsA("SpringConstraint") or obj:IsA("RopeConstraint")
        or obj:IsA("RodConstraint")    or obj:IsA("HingeConstraint")
        or obj:IsA("BallSocketConstraint") or obj:IsA("PrismaticConstraint")
        or obj:IsA("BodyVelocity")     or obj:IsA("BodyPosition")
        or obj:IsA("BodyForce")        or obj:IsA("BodyGyro") then
            -- cek dulu bukan bagian karakter
            local inChar = false
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Character and obj:IsDescendantOf(p.Character) then
                    inChar = true; break
                end
            end
            if not inChar then obj:Destroy() end
            return
        end
        if obj:IsA("SelectionBox") or obj:IsA("SelectionSphere") then
            obj:Destroy(); return
        end
        if obj:IsA("ClickDetector") then
            obj.MaxActivationDistance = 0; return
        end
        if obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
            -- hanya di workspace, bukan karakter player
            local inChar = false
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Character and obj:IsDescendantOf(p.Character) then
                    inChar = true; break
                end
            end
            if not inChar then obj.Enabled = false end
            return
        end
        if obj:IsA("Sound") then
            local inChar = false
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Character and obj:IsDescendantOf(p.Character) then
                    inChar = true; break
                end
            end
            if not inChar then
                obj.Volume = 0
                pcall(function() obj:Stop() end)
            end
            return
        end
        if obj:IsA("MeshPart") then
            if state.texture then
                obj.TextureID   = ""
                obj.Material    = Enum.Material.SmoothPlastic
                obj.Reflectance = 0
            end
            if state.shadow then obj.CastShadow = false end
            return
        end
        if obj:IsA("SpecialMesh") then
            if state.texture then obj.TextureId = "" end
            return
        end
        if obj:IsA("BasePart") then
            -- skip character parts dari world nuke
            local inChar = false
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Character and obj:IsDescendantOf(p.Character) then
                    inChar = true; break
                end
            end
            if inChar then return end

            if state.texture then
                obj.Material    = Enum.Material.SmoothPlastic
                obj.Reflectance = 0
            end
            if state.shadow then obj.CastShadow = false end
            if state.leaf and isLeafName(obj.Name) then
                obj.Transparency = 1
                obj.CanCollide   = false
                obj.CastShadow   = false
                return
            end
            if state.anchor then
                obj.Anchored = true
                pcall(function() obj:SetNetworkOwner(nil) end)
            end
            return
        end
        if obj:IsA("Decal") or obj:IsA("Texture") then
            if state.texture then obj.Transparency = 1 end
            return
        end
        if state.fx and (
            obj:IsA("ParticleEmitter") or obj:IsA("Fire")   or
            obj:IsA("Smoke")           or obj:IsA("Sparkles") or
            obj:IsA("Trail")           or obj:IsA("Beam")
        ) then
            local inChar = false
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Character and obj:IsDescendantOf(p.Character) then
                    inChar = true; break
                end
            end
            if not inChar then obj:Destroy() end
        end
    end)
end

local function applyRenderDistOnce()
    local char = lp.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return 0 end
    local rp, n = root.Position, 0
    for _, obj in ipairs(workspace:GetDescendants()) do
        pcall(function()
            if obj:IsA("BasePart") then
                local inChar = false
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.Character and obj:IsDescendantOf(p.Character) then
                        inChar = true; break
                    end
                end
                if not inChar and (obj.Position-rp).Magnitude > renderDist then
                    obj.Transparency = 1; n += 1
                end
            end
        end)
    end
    return n
end


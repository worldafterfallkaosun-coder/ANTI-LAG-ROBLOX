-- ================================================
-- FPS SYSTEM — rolling average, stable reading
-- ================================================
local FPS_SAMPLES    = {}
local FPS_MAX_SAMPLE = 60
local currentFPS     = 60

trackConn(RunService.RenderStepped:Connect(function(dt)
    if dt <= 0 then return end
    table.insert(FPS_SAMPLES, 1 / dt)
    if #FPS_SAMPLES > FPS_MAX_SAMPLE then
        table.remove(FPS_SAMPLES, 1)
    end
    local sum = 0
    for _, v in ipairs(FPS_SAMPLES) do sum = sum + v end
    currentFPS = math.floor(sum / #FPS_SAMPLES)
end))

local function colorFPS(fps)
    return fps >= 55 and Color3.fromRGB(80, 220, 120)
        or fps >= 40 and Color3.fromRGB(220, 200, 60)
        or fps >= 25 and Color3.fromRGB(220, 130, 60)
        or Color3.fromRGB(220, 70, 60)
end

-- ================================================
-- EXECUTOR BRIDGE
-- ================================================
local HAS_SETFPSCAP        = type(setfpscap) == "function"
local HAS_SETHIDDEN        = type(sethiddenproperty) == "function"

local function tryFPSCap(fps)
    if HAS_SETFPSCAP then
        pcall(setfpscap, fps)
        return true
    end
    return false
end

local function tryHidden(obj, prop, val)
    if HAS_SETHIDDEN then
        pcall(sethiddenproperty, obj, prop, val)
    end
end


-- PLAYER OPTIMIZATION CORE
-- Ini yang fix lag saat rame player
-- ================================================
local playerOptimized = {}  -- track player yang udah di-optimize

local leafKW = {
    "leaf","leaves","daun","foliage","tree","pohon","bush","shrub",
    "grass","rumput","plant","tanaman","bark","branch","vine","fern"
}

local function isLeafName(name)
    local low = name:lower()
    for _, k in ipairs(leafKW) do
        if low:find(k, 1, true) then return true end
    end
    return false
end

local function optimizeCharacter(char, isLocal)
    if not char then return end

    -- [1] Kill SurfaceAppearance di accessories
    --     ini paling berat: tiap hat/accessory punya PBR texture
    for _, obj in ipairs(char:GetDescendants()) do
        pcall(function()
            if obj:IsA("SurfaceAppearance") or obj:IsA("MaterialVariant") then
                obj:Destroy()

            elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail")
            or obj:IsA("Beam") or obj:IsA("Fire")
            or obj:IsA("Smoke") or obj:IsA("Sparkles") then
                -- aura, trail, fx dari accessories
                obj:Destroy()

            elseif obj:IsA("MeshPart") or obj:IsA("Part") then
                -- [2] Character parts -> SmoothPlastic
                obj.Material    = Enum.Material.SmoothPlastic
                obj.Reflectance = 0
                obj.CastShadow  = false
                -- Kill texture di MeshPart (hat texture)
                if obj:IsA("MeshPart") then
                    obj.TextureID = ""
                end

            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                obj.Transparency = 1

            elseif obj:IsA("PointLight") or obj:IsA("SpotLight")
            or obj:IsA("SurfaceLight") then
                -- tool glow, dll
                obj.Enabled = false

            elseif obj:IsA("Sound") then
                -- footstep, dll per karakter
                if not isLocal then
                    obj.Volume = 0
                    pcall(function() obj:Stop() end)
                end

            elseif obj:IsA("BillboardGui") then
                -- nameplate, health bar overhead
                if not isLocal then
                    obj.Enabled = false
                end

            elseif obj:IsA("Humanoid") and not isLocal then
                -- [3] Disable expensive humanoid states untuk non-local
                pcall(function()
                    obj:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                    obj:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                    obj:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)
                    obj.DisplayDistanceType  = Enum.HumanoidDisplayDistanceType.None
                    obj.HealthDisplayType    = Enum.HumanoidHealthDisplayType.AlwaysHide
                    obj.NameDisplayDistance  = 0
                    obj.HealthDisplayDistance = 0
                end)
            end
        end)
    end
end

-- Distance-based player LOD
-- Kalau player jauh, reduce lebih agresif
local function applyPlayerDistanceLOD()
    local char    = lp.Character
    local root    = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local rp = root.Position

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp and plr.Character then
            local otherRoot = plr.Character:FindFirstChild("HumanoidRootPart")
            if otherRoot then
                local dist = (otherRoot.Position - rp).Magnitude
                local otherChar = plr.Character

                if dist > CFG.playerLODDist then
                    -- player jauh: hide accessories, reduce quality
                    for _, obj in ipairs(otherChar:GetDescendants()) do
                        pcall(function()
                            if obj:IsA("Accessory") then
                                local handle = obj:FindFirstChild("Handle")
                                if handle then
                                    handle.Transparency = 1
                                end
                            elseif obj:IsA("Animator") then
                                -- pause animator kalau jauh
                                -- obj:GetPlayingAnimationTracks() lalu :AdjustSpeed(0)
                                -- disabled: bisa bikin T-pose, skip
                            end
                        end)
                    end
                else
                    -- player deket: pastiin accessories visible
                    for _, obj in ipairs(otherChar:GetDescendants()) do
                        pcall(function()
                            if obj:IsA("Accessory") then
                                local handle = obj:FindFirstChild("Handle")
                                if handle and handle.Transparency == 1 then
                                    handle.Transparency = 0
                                end
                            end
                        end)
                    end
                end
            end
        end
    end
end

-- Optimize semua player existing + listen yang baru masuk
local function setupPlayerOptimization()
    -- Optimize semua player yang udah ada
    for _, plr in ipairs(Players:GetPlayers()) do
        local isLocal = plr == lp
        local function handleChar(char)
            if playerOptimized[plr.UserId] then return end
            task.wait(0.5) -- tunggu char fully loaded
            optimizeCharacter(char, isLocal)
            playerOptimized[plr.UserId] = true

            -- Listen kalau ada item baru ditambah ke char (equip weapon, etc)
            trackConn(char.DescendantAdded:Connect(function(obj)
                task.defer(function()
                    pcall(function()
                        if obj:IsA("SurfaceAppearance") or obj:IsA("MaterialVariant") then
                            obj:Destroy()
                        elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail")
                        or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
                            obj:Destroy()
                        elseif obj:IsA("MeshPart") then
                            obj.TextureID   = ""
                            obj.Material    = Enum.Material.SmoothPlastic
                            obj.CastShadow  = false
                        end
                    end)
                end)
            end))
        end

        if plr.Character then
            task.spawn(handleChar, plr.Character)
        end
        trackConn(plr.CharacterAdded:Connect(function(char)
            playerOptimized[plr.UserId] = nil -- reset biar di-re-optimize
            task.spawn(handleChar, char)
        end))
    end

    -- Player baru masuk
    trackConn(Players.PlayerAdded:Connect(function(plr)
        local isLocal = plr == lp
        trackConn(plr.CharacterAdded:Connect(function(char)
            playerOptimized[plr.UserId] = nil
            task.spawn(function()
                task.wait(0.5)
                optimizeCharacter(char, isLocal)
                playerOptimized[plr.UserId] = true

                trackConn(char.DescendantAdded:Connect(function(obj)
                    task.defer(function()
                        pcall(function()
                            if obj:IsA("SurfaceAppearance") or obj:IsA("MaterialVariant") then
                                obj:Destroy()
                            elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail")
                            or obj:IsA("Fire") or obj:IsA("Smoke") then
                                obj:Destroy()
                            elseif obj:IsA("MeshPart") then
                                obj.TextureID  = ""
                                obj.Material   = Enum.Material.SmoothPlastic
                                obj.CastShadow = false
                            end
                        end)
                    end)
                end))
            end)
        end))
    end))

    -- Player keluar: cleanup tracking
    trackConn(Players.PlayerRemoving:Connect(function(plr)
        playerOptimized[plr.UserId] = nil
    end))
end

-- ================================================
-- ADAPTIVE FPS SYSTEM
-- Monitor FPS, kalau drop -> auto optimize lebih
-- ================================================
local adaptiveConn = nil
local lastAdaptiveCheck = 0

local function startAdaptiveSystem(logBox, statusVal)
    if adaptiveConn then
        pcall(function() adaptiveConn:Disconnect() end)
    end

    adaptiveConn = RunService.Heartbeat:Connect(function()
        local now = os.clock()
        if now - lastAdaptiveCheck < 3 then return end -- check tiap 3 detik
        lastAdaptiveCheck = now

        local fps = currentFPS

        if fps < CFG.fpsLowThreshold and adaptiveTier < 2 then
            adaptiveTier = adaptiveTier + 1

            if adaptiveTier == 1 then
                -- Mild: reduce render dist 25%
                renderDist = math.max(128, renderDist * 0.75)
                logBox.Text = "> adaptive tier 1: dist->" .. renderDist
                -- Re-apply render distance
                task.spawn(function()
                    local char = lp.Character
                    local root = char and char:FindFirstChild("HumanoidRootPart")
                    if not root then return end
                    local rp = root.Position
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        pcall(function()
                            if obj:IsA("BasePart") then
                                local isChar = false
                                for _, p in ipairs(Players:GetPlayers()) do
                                    if p.Character and obj:IsDescendantOf(p.Character) then
                                        isChar = true; break
                                    end
                                end
                                if not isChar and (obj.Position-rp).Magnitude > renderDist then
                                    obj.Transparency = 1
                                end
                            end
                        end)
                    end
                end)

            elseif adaptiveTier == 2 then
                -- Severe: kill semua non-essential
                logBox.Text = "> adaptive tier 2: max reduction"
                task.spawn(function()
                    -- Kill semua remaining lights
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        pcall(function()
                            if obj:IsA("PointLight") or obj:IsA("SpotLight")
                            or obj:IsA("SurfaceLight") then
                                obj.Enabled = false
                            elseif obj:IsA("Sound") then
                                obj.Volume = 0
                            end
                        end)
                    end
                    -- Bump FPS cap kalau setfpscap available
                    -- cap lebih rendah = lebih stable di hardware lemah
                    if HAS_SETFPSCAP then
                        pcall(setfpscap, 30) -- target 30 stable > 60 unstable
                    end
                    -- Kill player LOD agresif
                    applyPlayerDistanceLOD()
                end)
            end

            statusVal.Text       = "● ADAPTIVE T" .. adaptiveTier
            statusVal.TextColor3 = Color3.fromRGB(255, 180, 0)

        elseif fps >= 50 and adaptiveTier > 0 then
            -- FPS recover, reset tier
            adaptiveTier = 0
            statusVal.Text       = "● ACTIVE"
            statusVal.TextColor3 = Color3.fromRGB(0, 255, 136)
        end
    end)

    trackConn(adaptiveConn)
end


local function log(msg) logBox.Text = "> " .. msg end

local leafKW = {"leaf","leaves","daun","foliage","tree","pohon","bush","shrub","grass","rumput","plant","tanaman"}
local function isLeaf(name)
    name = name:lower()
    for _, k in pairs(leafKW) do
        if name:find(k) then return true end
    end
    return false
end

-- ================================================
-- [FIX] TEXTURE NUKE — covers ALL part types
-- ================================================
local function nukePartTexture(obj)
    -- BasePart (normal part, union, meshpart, special mesh)
    if obj:IsA("BasePart") then
        pcall(function()
            obj.Material = Enum.Material.SmoothPlastic
            obj.Reflectance = 0
        end)
    end

    -- MeshPart: force TextureID ke kosong
    if obj:IsA("MeshPart") then
        pcall(function() obj.TextureID = "" end)
    end

    -- SpecialMesh: kill texture
    if obj:IsA("SpecialMesh") then
        pcall(function() obj.TextureId = "" end)
    end

    -- Decal & Texture: invisible
    if obj:IsA("Decal") or obj:IsA("Texture") then
        pcall(function() obj.Transparency = 1 end)
    end

    -- SurfaceAppearance: DESTROY ini yang bikin PBR texture keliatan
    -- ini penyebab error "MaterialVariant" di console lo
    if obj:IsA("SurfaceAppearance") then
        pcall(function() obj:Destroy() end)
    end

    -- MaterialVariant juga nuke
    if obj:IsA("MaterialVariant") then
        pcall(function() obj:Destroy() end)
    end
end

-- ================================================
-- [FIX] RENDER DISTANCE via Camera + LOD
-- ================================================
local function applyRenderDistance(dist)
    -- Method 1: Camera MaxRenderDistance (works on most games)
    pcall(function()
        workspace.CurrentCamera.DiagonalFieldOfView = workspace.CurrentCamera.DiagonalFieldOfView
    end)

    -- Method 2: StreamingEnabled MaxActiveParts radius
    pcall(function()
        if workspace.StreamingEnabled then
            -- Can't set from LocalScript but we hide far parts manually
        end
    end)

    -- Method 3: Manual — hide parts beyond dist studs dari player
    task.spawn(function()
        local char = lp.Character or lp.CharacterAdded:Wait()
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        log("applying render dist " .. dist .. " studs...")
        local hiddenParts = {}

        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                local isChar = false
                for _, p in pairs(Players:GetPlayers()) do
                    if p.Character and obj:IsDescendantOf(p.Character) then
                        isChar = true; break
                    end
                end
                if not isChar then
                    local d = (obj.Position - root.Position).Magnitude
                    if d > dist then
                        if obj.Transparency < 1 then
                            hiddenParts[obj] = obj.Transparency
                            pcall(function() obj.Transparency = 1 end)
                        end
                    end
                end
            end
        end

        -- live update render distance on move
        RunService.Heartbeat:Connect(function()
            local r = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
            if not r then return end
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") then
                    local isChar = false
                    for _, p in pairs(Players:GetPlayers()) do
                        if p.Character and obj:IsDescendantOf(p.Character) then
                            isChar = true; break
                        end
                    end
                    if not isChar then
                        local d = (obj.Position - r.Position).Magnitude
                        if d > renderDist and obj.Transparency < 0.99 then
                            pcall(function() obj.Transparency = 1 end)
                        end
                    end
                end
            end
        end)
    end)
end


applyBtn.MouseButton1Click:Connect(function()
    if not applied then
        local b = getFPS()
        fpsBeforeVal.Text       = b .. " fps"
        fpsBeforeVal.TextColor3 = colorFPS(b)
    end

    statusVal.Text            = "● RUNNING"
    statusVal.TextColor3      = Color3.fromRGB(255, 180, 0)
    applyBtn.Text             = "..."
    applyBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    applyBtn.TextColor3       = Color3.fromRGB(0, 220, 110)

    task.spawn(function()

        -- [A] FPS CAP BYPASS
        log("setting fps cap " .. fpsCapValue .. "...")
        local capMethod = trySetFPSCap(fpsCapValue)

        -- [B] GRAPHICS QUALITY FORCE
        pcall(function()
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        end)

        -- [C] HIDDEN PROPERTIES (executor only)
        -- Compatibility = paling ringan, matiin PBR pipeline
        trySetHidden(Lighting, "Technology",
            Enum.Technology.Compatibility)
        -- Shadow map off
        trySetHidden(Lighting, "ShadowSoftness", 0)
        -- Mesh LOD force lowest
        trySetHidden(workspace, "MeshPartHeads", false)
        -- Streaming radius minimum
        trySetHidden(workspace, "StreamingMinRadius", 64)
        trySetHidden(workspace, "StreamingTargetRadius", renderDist)

        -- [D] LIGHTING NUKE
        if state.shadow then
            log("killing lights & shadows...")
            pcall(function() Lighting.GlobalShadows = false end)
            pcall(function() Lighting.Brightness    = 2 end)
            for _, v in ipairs(Lighting:GetChildren()) do
                pcall(function()
                    if v:IsA("BlurEffect") or v:IsA("ColorCorrectionEffect")
                    or v:IsA("SunRaysEffect") or v:IsA("BloomEffect")
                    or v:IsA("DepthOfFieldEffect") or v:IsA("PostEffect") then
                        v:Destroy()
                    end
                end)
            end
        end

        -- [E] ATMOSPHERE
        for _, v in ipairs(Lighting:GetChildren()) do
            pcall(function()
                if v:IsA("Atmosphere") then
                    v.Density = 0; v.Glare = 0
                    v.Haze    = 0; v.Offset = 0
                end
            end)
        end

        -- [F] SKY
        if state.sky then
            log("killing skybox...")
            for _, v in ipairs(Lighting:GetChildren()) do
                pcall(function()
                    if v:IsA("Sky") then v:Destroy() end
                end)
            end
        end

        -- [G] SOUND SERVICE MUTE
        if CFG.soundKill then
            log("muting audio...")
            pcall(function() SoundService.RespectFilteringEnabled = false end)
        end

        -- [H] TERRAIN
        pcall(function()
            local t = workspace:FindFirstChildOfClass("Terrain")
            if t then
                t.WaterWaveSize    = 0; t.WaterWaveSpeed   = 0
                t.WaterReflectance = 0; t.WaterTransparency = 0
            end
        end)

        -- [I] MAIN SCAN — batched biar ga freeze
        log("nuking workspace...")
        local total   = 0
        local list    = workspace:GetDescendants()
        local BATCH   = 250
        for i = 1, #list, BATCH do
            for j = i, math.min(i + BATCH - 1, #list) do
                nukeObject(list[j])
                total += 1
            end
            task.wait()
        end

        -- [J] RENDER DISTANCE ONE-SHOT
        log("applying render dist...")
        local hidden = applyRenderDistOnce()

        -- [K] CAMERA TRICK — narrow FOV = less geometry rendered
        pcall(function()
            local cam = workspace.CurrentCamera
            -- don't override if game uses custom FOV
        end)

        task.wait(0.8) -- kasih waktu FPS stabil
        applied = true
        local af = getFPS()
        fpsAfterVal.Text       = af .. " fps"
        fpsAfterVal.TextColor3 = colorFPS(af)

        log(total .. " obj | " .. hidden .. " hidden | " .. capMethod)
        statusVal.Text            = "● ACTIVE"
        statusVal.TextColor3      = Color3.fromRGB(0, 255, 136)
        applyBtn.Text             = "⚡ RE-APPLY"
        applyBtn.BackgroundColor3 = Color3.fromRGB(0, 220, 110)
        applyBtn.TextColor3       = Color3.fromRGB(0, 0, 0)
    end)
end)


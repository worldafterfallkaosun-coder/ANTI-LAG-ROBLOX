local FPS_SAMPLES = {}
local currentFPS  = 60

trackConn(RunService.RenderStepped:Connect(function(dt)
    if dt <= 0 then return end
    table.insert(FPS_SAMPLES, 1/dt)
    if #FPS_SAMPLES > 60 then table.remove(FPS_SAMPLES, 1) end
    local s = 0
    for _, v in ipairs(FPS_SAMPLES) do s = s + v end
    currentFPS = math.floor(s / #FPS_SAMPLES)
end))

local function colorFPS(fps)
    return fps >= 55 and Color3.fromRGB(80,220,120)
        or fps >= 40 and Color3.fromRGB(220,200,60)
        or fps >= 25 and Color3.fromRGB(220,130,60)
        or Color3.fromRGB(220,70,60)
end

-- ================================================
-- EXECUTOR BRIDGE
-- ================================================
local HAS_SETFPSCAP = type(setfpscap) == "function"
local HAS_SETHIDDEN = type(sethiddenproperty) == "function"

local function tryFPSCap(fps)
    if HAS_SETFPSCAP then pcall(setfpscap, fps); return true end
    return false
end
local function tryHidden(obj, prop, val)
    if HAS_SETHIDDEN then pcall(sethiddenproperty, obj, prop, val) end
end

-- ================================================
-- v5.3: CAMERA MAX ZOOM BYPASS
-- ================================================
local Camera = workspace.CurrentCamera

local function applyZoomBypass()
    if zoomBypassActive then return end
    zoomBypassActive = true

    -- set MaxZoomDistance via sethiddenproperty jika tersedia
    -- fallback: loop terus paksa lewat Camera.CFrame (non-destructive)
    pcall(function()
        local char = lp.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                -- langsung set hidden prop MaxZoomDistance
                tryHidden(hum, "CameraMaxZoomDistance", ZOOM_BYPASS_LIMIT)
            end
        end
    end)

    -- persistent loop: jaga nilainya tiap kali karakter spawn ulang
    zoomBypassConn = RunService.Heartbeat:Connect(function()
        pcall(function()
            local char = lp.Character
            if not char then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hum then return end
            -- jika sethiddenproperty tersedia, paksa terus
            if HAS_SETHIDDEN then
                pcall(sethiddenproperty, hum, "CameraMaxZoomDistance", ZOOM_BYPASS_LIMIT)
            else
                -- fallback: set lewat property biasa (beberapa executor expose ini)
                if hum.CameraMaxZoomDistance < ZOOM_BYPASS_LIMIT then
                    hum.CameraMaxZoomDistance = ZOOM_BYPASS_LIMIT
                end
            end
        end)
    end)
    trackConn(zoomBypassConn)
end

local function removeZoomBypass()
    if not zoomBypassActive then return end
    zoomBypassActive = false
    if zoomBypassConn then
        pcall(function() zoomBypassConn:Disconnect() end)
        zoomBypassConn = nil
    end
    -- restore default 400 studs
    pcall(function()
        local char = lp.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            if HAS_SETHIDDEN then
                pcall(sethiddenproperty, hum, "CameraMaxZoomDistance", 400)
            else
                hum.CameraMaxZoomDistance = 400
            end
        end
    end)
end


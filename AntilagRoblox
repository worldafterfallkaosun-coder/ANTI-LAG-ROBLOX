local MIN_RD, MAX_RD = 64, 1024
local slideDragging = false

local function setRDValue(val)
    val = math.clamp(math.floor(val), MIN_RD, MAX_RD)
    renderDist = val
    local pct = (val - MIN_RD) / (MAX_RD - MIN_RD)
    sliderFill.Size     = UDim2.new(pct, 0, 1, 0)
    sliderThumb.Position = UDim2.new(pct, 0, 0.5, 0)
    rdValLbl.Text       = tostring(val)
end

local function posToRDVal(xPos)
    local abs = sliderTrack.AbsolutePosition
    local sz  = sliderTrack.AbsoluteSize
    local pct = math.clamp((xPos - abs.X) / sz.X, 0, 1)
    return MIN_RD + pct * (MAX_RD - MIN_RD)
end


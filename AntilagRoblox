        Size = UDim2.new(0, 28, 0, 14), Position = UDim2.new(1, -34, 0.5, -7), BorderSizePixel = 0,
    }, row)
    corner(pill, FULL)
    local knob = new("Frame", {
        Size = UDim2.new(0, 10, 0, 10), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
    }, pill)
    corner(knob, FULL)

    local function refresh(animate)
        local on = state[key]
        local pc = on and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(55, 55, 55)
        local kp = on and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)
        if animate then
            TweenService:Create(pill, TweenInfo.new(0.12), {BackgroundColor3 = pc}):Play()
            TweenService:Create(knob, TweenInfo.new(0.12), {Position = kp}):Play()
        else
            pill.BackgroundColor3 = pc
            knob.Position = kp
        end
    end
    refresh(false)
    toggleRefresh[key] = refresh

    local btn = new("TextButton", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", ZIndex = 5,
    }, row)
    btn.MouseButton1Click:Connect(function()
        state[key] = not state[key]
        refresh(true)
        saveConfig()
    end)
end


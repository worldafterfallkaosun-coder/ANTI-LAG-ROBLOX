-- ================================================
-- FPS UTILITY (smooth rolling average)
-- ================================================
local fpsSamples = {}
local FPS_SAMPLE = 30  -- jumlah sample di-average

local function getFPS()
    local sum = 0
    for _, v in ipairs(fpsSamples) do sum = sum + v end
    return #fpsSamples > 0 and math.floor(sum / #fpsSamples) or 0
end

RunService.RenderStepped:Connect(function(dt)
    table.insert(fpsSamples, 1/dt)
    if #fpsSamples > FPS_SAMPLE then
        table.remove(fpsSamples, 1)
    end
end)


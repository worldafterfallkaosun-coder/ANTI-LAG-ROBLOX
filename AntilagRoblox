-- ================================================
-- SLIDER BUILDER
-- ================================================
local function makeSlider(parent, order, labelText, initVal, minV, maxV, color, snapTo)
    local frame = Instance.new("Frame", parent)
    frame.Size=UDim2.new(1,0,0,44); frame.BackgroundColor3=Color3.fromRGB(20,20,20)
    frame.BorderSizePixel=0; frame.LayoutOrder=order
    Instance.new("UICorner",frame).CornerRadius=UDim.new(0,6)
    local pad=Instance.new("UIPadding",frame)
    pad.PaddingLeft=UDim.new(0,8); pad.PaddingRight=UDim.new(0,8)
    pad.PaddingTop=UDim.new(0,6);  pad.PaddingBottom=UDim.new(0,6)
    local fl=Instance.new("UIListLayout",frame)
    fl.FillDirection=Enum.FillDirection.Vertical; fl.Padding=UDim.new(0,5)

    local topRow=Instance.new("Frame",frame)
    topRow.Size=UDim2.new(1,0,0,12); topRow.BackgroundTransparency=1

    local lbl=Instance.new("TextLabel",topRow)
    lbl.Text=labelText; lbl.Font=Enum.Font.Code; lbl.TextSize=9
    lbl.TextColor3=Color3.fromRGB(170,170,170); lbl.BackgroundTransparency=1
    lbl.Size=UDim2.new(0.6,0,1,0); lbl.TextXAlignment=Enum.TextXAlignment.Left

    local valLbl=Instance.new("TextLabel",topRow)
    valLbl.Text=tostring(initVal); valLbl.Font=Enum.Font.Code; valLbl.TextSize=9
    valLbl.TextColor3=color; valLbl.BackgroundTransparency=1
    valLbl.Size=UDim2.new(0.4,0,1,0); valLbl.Position=UDim2.new(0.6,0,0,0)
    valLbl.TextXAlignment=Enum.TextXAlignment.Right

    local track=Instance.new("Frame",frame)
    track.Size=UDim2.new(1,0,0,6); track.BackgroundColor3=Color3.fromRGB(38,38,38)
    track.BorderSizePixel=0
    Instance.new("UICorner",track).CornerRadius=UDim.new(1,0)

    local fill=Instance.new("Frame",track)
    local ip=(initVal-minV)/(maxV-minV)
    fill.Size=UDim2.new(ip,0,1,0); fill.BackgroundColor3=color
    fill.BorderSizePixel=0
    Instance.new("UICorner",fill).CornerRadius=UDim.new(1,0)

    local thumb=Instance.new("TextButton",track)
    thumb.Size=UDim2.new(0,16,0,16); thumb.AnchorPoint=Vector2.new(0.5,0.5)
    thumb.Position=UDim2.new(ip,0,0.5,0)
    thumb.BackgroundColor3=Color3.fromRGB(240,240,240)
    thumb.Text=""; thumb.BorderSizePixel=0; thumb.ZIndex=10
    Instance.new("UICorner",thumb).CornerRadius=UDim.new(1,0)

    local isDragging = false
    local currentVal = initVal

    local function setValue(raw)
        local s = snapTo and math.floor(raw/snapTo)*snapTo or math.floor(raw)
        s = math.clamp(s, minV, maxV)
        currentVal = s
        local pct = (s-minV)/(maxV-minV)
        fill.Size=UDim2.new(pct,0,1,0)
        thumb.Position=UDim2.new(pct,0,0.5,0)
        valLbl.Text=tostring(s)
        return s
    end

    local function posToVal(xPos)
        local abs=track.AbsolutePosition; local sz=track.AbsoluteSize
        return minV + math.clamp((xPos-abs.X)/sz.X,0,1)*(maxV-minV)
    end

    thumb.MouseButton1Down:Connect(function() isDragging=true end)
    track.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1
        or i.UserInputType==Enum.UserInputType.Touch then
            isDragging=true; setValue(posToVal(i.Position.X))
        end
    end)

    return frame, track, setValue, posToVal,
           function() return isDragging end,
           function(v) isDragging=v end,
           function() return currentVal end
end


local function onNukeDone()
    nukeActive = false
    log(nukeTotal .. " obj | " .. culledN .. " hidden ✓")
    setStatus(tier > 0 and "● ADAPTIVE T" .. tier or "● ACTIVE", tier > 0 and AMBER or GREEN)
    applyBtn.Text = "⚡ RE-APPLY"
    applyBtn.BackgroundColor3 = Color3.fromRGB(0, 220, 110)
    applyBtn.TextColor3 = Color3.new(0, 0, 0)
end

applyNuke = function()
    if busy or nukeActive then return end
    if not applied then
        fpsBeforeVal.Text = currentFPS .. " fps"
        fpsBeforeVal.TextColor3 = colorFPS(currentFPS)
    end
    applied, nukeActive = true, true
    setStatus("● RUNNING", AMBER)
    applyBtn.Text = "..."
    applyBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    applyBtn.TextColor3 = Color3.fromRGB(0, 220, 110)
    log("fps cap " .. fpsCapValue .. (tryFPSCap(fpsCapValue) and " ✓" or " (no executor)"))
    applyGlobals()
    local list = workspace:GetDescendants()
    table.move(list, 1, #list, qt + 1, queue)
    qt += #list
    nukeTotal, nukeDone = #list, 0
end

-- Sinkron saat unload supaya state sudah bersih sebelum skrip berikutnya berjalan.
local function runRestore(sync)
    applied, nukeActive, tier = false, false, 0
    queue, qh, qt = {}, 1, 0
    local t0 = os.clock()
    local function pace()
        if not sync and os.clock() - t0 > 0.008 then task.wait(); t0 = os.clock() end
    end
    for obj, props in pairs(orig) do
        for prop, val in pairs(props) do pcall(setProp, obj, prop, val) end
        pace()
    end
    for obj, parent in pairs(stashed) do
        if parent:IsDescendantOf(game) then pcall(setProp, obj, "Parent", parent) end
        pace()
    end
    if HAS_SETHIDDEN then
        for i = #hiddenOrig, 1, -1 do
            local h = hiddenOrig[i]
            pcall(sethiddenproperty, h[1], h[2], h[3])
        end
    end
    for hum in pairs(touchedHum) do
        for _, s in ipairs(HUM_STATES) do pcall(hum.SetStateEnabled, hum, s, true) end
    end
    table.clear(orig); table.clear(stashed); table.clear(hiddenOrig); table.clear(touchedHum)
    table.clear(culled); table.clear(parts); table.clear(partIdx)
    culledN, cursor = 0, 0
    tryFPSCap(CFG.fpsTarget)
end

restoreAll = function()
    if busy then return end
    busy = true
    setStatus("● RESTORING", AMBER)
    task.spawn(function()
        runRestore(false)
        setApplyIdle()
        fpsAfterVal.Text = "-- fps"
        fpsAfterVal.TextColor3 = DIM
        setStatus("● READY", GREEN)
        log("restored")
        busy = false
    end)
end

unload = function()
    if not alive then return end
    alive = false
    for _, c in ipairs(CONNECTIONS) do pcall(function() c:Disconnect() end) end
    runRestore(true)
    if env.NonoCleanup == unload then env.NonoCleanup = nil end
    sg:Destroy()
end


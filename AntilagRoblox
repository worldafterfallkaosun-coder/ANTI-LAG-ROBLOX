-- ================================================
-- FPS COUNTER
-- ================================================
local fpsSamples = {}
local function getFPS()
    local s = 0
    for _, v in ipairs(fpsSamples) do s = s + v end
    return #fpsSamples > 0 and math.floor(s / #fpsSamples) or 0
end
RunService.RenderStepped:Connect(function(dt)
    table.insert(fpsSamples, 1 / dt)
    if #fpsSamples > 40 then table.remove(fpsSamples, 1) end
end)


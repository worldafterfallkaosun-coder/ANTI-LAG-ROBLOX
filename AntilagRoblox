-- ================================================
-- DRAG — FIXED (isolated, no touch bleed)
-- ================================================
local dragging   = false
local dragStart  = nil
local startPos   = nil
local DRAG_DEAD  = 6  -- pixel deadzone biar ga trigger saat tap

-- Hanya header yang bisa drag
header.InputBegan:Connect(function(input)
    -- jangan trigger kalau klik toggleBtn
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragStart = input.Position
        startPos  = main.Position
        dragging  = false  -- belum drag sampai melewati deadzone
    end
end)

UserInputService.InputChanged:Connect(function(input)
    -- slider priority
    if slideDragging then
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            setRDValue(posToRDVal(input.Position.X))
        end
        return
    end

    -- drag hanya aktif kalau dragStart ada dan cursor di header zone
    if dragStart and (
        input.UserInputType == Enum.UserInputType.MouseMovement or
        input.UserInputType == Enum.UserInputType.Touch
    ) then
        local delta = input.Position - dragStart
        -- deadzone check
        if not dragging and (math.abs(delta.X) > DRAG_DEAD or math.abs(delta.Y) > DRAG_DEAD) then
            dragging = true
        end
        if dragging then
            main.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging      = false
        dragStart     = nil
        slideDragging = false
    end
end)

-- ================================================
-- NUKE FUNCTIONS (no Heartbeat loop — one-shot only)
-- ================================================
local leafKW = {
    "leaf","leaves","daun","foliage","tree","pohon",
    "bush","shrub","grass","rumput","plant","tanaman","bark","branch"
}
local function isLeaf(name)
    name = name:lower()
    for _, k in ipairs(leafKW) do
        if name:find(k,1,true) then return true end
    end
    return false
end

local function nukeObject(obj)
    pcall(function()
        -- TEXTURE: SurfaceAppearance adalah biang PBR texture
        if obj:IsA("SurfaceAppearance") or obj:IsA("MaterialVariant") then
            obj:Destroy(); return
        end

        if obj:IsA("MeshPart") then
            if state.texture then
                obj.TextureID   = ""
                obj.Material    = Enum.Material.SmoothPlastic
                obj.Reflectance = 0
                obj.CastShadow  = state.shadow and false or obj.CastShadow
            end
            return
        end

        if obj:IsA("SpecialMesh") then
            if state.texture then obj.TextureId = "" end
            return
        end

        if obj:IsA("BasePart") then
            if state.texture then
                obj.Material    = Enum.Material.SmoothPlastic
                obj.Reflectance = 0
            end
            if state.shadow then obj.CastShadow = false end

            if state.leaf and isLeaf(obj.Name) then
                obj.Transparency = 1
                obj.CanCollide   = false
                obj.CastShadow   = false
                return
            end

            -- Render distance: tandai visibility, bukan loop tiap frame
            -- (dihandle di apply sekali saja, bukan Heartbeat)
            if state.anchor then
                local isChar = false
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.Character and obj:IsDescendantOf(p.Character) then
                        isChar = true; break
                    end
                end
                if not isChar then obj.Anchored = true end
            end
            return
        end

        if obj:IsA("Decal") or obj:IsA("Texture") then
            if state.texture then obj.Transparency = 1 end
            return
        end

        if state.fx and (
            obj:IsA("ParticleEmitter") or obj:IsA("Fire") or
            obj:IsA("Smoke") or obj:IsA("Sparkles") or
            obj:IsA("Trail") or obj:IsA("Beam")
        ) then
            obj:Destroy()
        end
    end)
end

-- ================================================
-- RENDER DISTANCE — ONE-SHOT, BUKAN HEARTBEAT LOOP
-- Heartbeat tiap frame scan ribuan part = LAG
-- Ganti: scan sekali, set Transparency, selesai
-- ================================================
local function applyRenderDistOnce()
    local char = lp.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local rp = root.Position
    local count = 0

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local isChar = false
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Character and obj:IsDescendantOf(p.Character) then
                    isChar = true; break
                end
            end
            if not isChar then
                local d = (obj.Position - rp).Magnitude
                if d > renderDist and obj.Transparency < 0.99 then
                    pcall(function() obj.Transparency = 1 end)
                    count = count + 1
                end
            end
        end
    end
    return count
end


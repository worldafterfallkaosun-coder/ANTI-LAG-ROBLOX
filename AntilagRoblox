local lodTimer, adaptTimer, logTimer = 0, 0, 0
trackConn(RunService.Heartbeat:Connect(function(dt)
    if not applied then return end
    local t0 = os.clock()
    local budget = nukeActive and 0.006 or 0.0015

    while qh <= qt and os.clock() - t0 < budget do
        local obj = queue[qh]
        queue[qh] = nil
        qh += 1
        if obj.Parent then pcall(processObject, obj) end
        nukeDone += 1
    end
    if qh > qt and qt > 0 then queue, qh, qt = {}, 1, 0 end

    local n = #parts
    local cam = workspace.CurrentCamera
    if n > 0 and cam then
        local cp = cam.CFrame.Position
        local far = userDist * TIER_DIST[tier + 1]
        local near = far * 0.85
        local i = cursor
        for _ = 1, math.min(n, math.max(400, math.floor(n / 30))) do
            i = i % n + 1
            local p = parts[i]
            -- Ukuran part dikurangi dari jarak supaya lantai besar tidak ikut hilang.
            local d = (p.Position - cp).Magnitude - p.Size.Magnitude * 0.5
            if d > far then
                if not culled[p] then
                    culled[p] = true
                    culledN += 1
                    set(p, "Transparency", 1)
                end
            elseif d < near and culled[p] then
                culled[p] = nil
                culledN -= 1
                local o = orig[p]
                if o and o.Transparency ~= nil then p.Transparency = o.Transparency end
            end
        end
        cursor = i
    end

    if nukeActive then
        logTimer += dt
        if logTimer >= 0.25 then
            logTimer = 0
            log("nuking " .. math.min(nukeDone, nukeTotal) .. "/" .. nukeTotal)
        end
        if qh > qt then onNukeDone() end
        return
    end

    lodTimer += dt
    if lodTimer >= 1 then lodTimer = 0; updatePlayerLOD() end
    adaptTimer += dt
    if adaptTimer >= 3 then adaptTimer = 0; adaptiveStep() end
end))


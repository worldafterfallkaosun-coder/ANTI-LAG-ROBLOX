-- slider drag logic
local slideDragging = false
local MIN_RD, MAX_RD = 64, 1024

local function updateSlider(val)
    val = math.clamp(val, MIN_RD, MAX_RD)
    renderDist = val
    local pct = (val - MIN_RD) / (MAX_RD - MIN_RD)
    sliderFill.Size = UDim2.new(pct, 0, 1, 0)
    sliderThumb.Position = UDim2.new(pct, 0, 0.5, 0)
    rdVal.Text = tostring(math.floor(val))
end

sliderThumb.MouseButton1Down:Connect(function() slideDragging = true end)
sliderThumb.TouchLongPress:Connect(function() slideDragging = true end)

UserInputService.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
    or i.UserInputType == Enum.UserInputType.Touch then
        if slideDragging then slideDragging = false end
        if dragging then dragging = false end
    end
end)

local function getSliderVal(inputPos)
    local abs = sliderTrack.AbsolutePosition
    local sz  = sliderTrack.AbsoluteSize
    local pct = math.clamp((inputPos.X - abs.X) / sz.X, 0, 1)
    return MIN_RD + pct * (MAX_RD - MIN_RD)
end

sliderTrack.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
    or i.UserInputType == Enum.UserInputType.Touch then
        slideDragging = true
        updateSlider(getSliderVal(i.Position))
    end
end)


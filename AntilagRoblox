-- ================================================
-- DRAG — header only, deadzone, isolated
-- ================================================
local dragActive = false
local dragStart  = nil
local dragOrigin = nil
local DEADZONE   = 8

header.InputBegan:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.MouseButton1
    or input.UserInputType==Enum.UserInputType.Touch then
        -- ignore kalau klik nBtn
        local pos   = input.Position
        local nbAbs = nBtn.AbsolutePosition
        local nbSz  = nBtn.AbsoluteSize
        local onBtn = pos.X >= nbAbs.X and pos.X <= nbAbs.X+nbSz.X
                   and pos.Y >= nbAbs.Y and pos.Y <= nbAbs.Y+nbSz.Y
        if onBtn then return end

        dragStart  = pos
        dragOrigin = main.Position
        dragActive = false
    end
end)

header.InputEnded:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.MouseButton1
    or input.UserInputType==Enum.UserInputType.Touch then
        dragActive=false; dragStart=nil
    end
end)

trackConn(UserInputService.InputChanged:Connect(function(input)
    if getCapDrag() then
        if input.UserInputType==Enum.UserInputType.MouseMovement
        or input.UserInputType==Enum.UserInputType.Touch then
            local v=setCapVal(capPosToVal(input.Position.X))
            fpsCapValue=v
            pcall(function() if HAS_SETFPSCAP then setfpscap(v) end end)
        end; return
    end
    if getRDDrag() then
        if input.UserInputType==Enum.UserInputType.MouseMovement
        or input.UserInputType==Enum.UserInputType.Touch then
            local v=setRDVal(rdPosToVal(input.Position.X))
            renderDist=v
        end; return
    end
    if dragStart then
        if input.UserInputType==Enum.UserInputType.MouseMovement
        or input.UserInputType==Enum.UserInputType.Touch then
            local delta=input.Position-dragStart
            if not dragActive and
               (math.abs(delta.X)>DEADZONE or math.abs(delta.Y)>DEADZONE) then
                dragActive=true
            end
            if dragActive and dragOrigin then
                main.Position=UDim2.new(
                    dragOrigin.X.Scale, dragOrigin.X.Offset+delta.X,
                    dragOrigin.Y.Scale, dragOrigin.Y.Offset+delta.Y
                )
            end
        end
    end
end))

trackConn(UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.MouseButton1
    or input.UserInputType==Enum.UserInputType.Touch then
        dragActive=false; dragStart=nil
        setCapDrag(false); setRDDrag(false)
    end
end))


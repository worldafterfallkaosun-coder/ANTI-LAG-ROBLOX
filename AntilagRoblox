local function makeSlider(name, init, minV, maxV, color, snap, onChange)
    local frame = new("Frame", {
        Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = ROW, BorderSizePixel = 0,
        LayoutOrder = nextOrd(),
    }, body)
    corner(frame, 6)
    new("UIPadding", {
        PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
        PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6),
    }, frame)
    new("UIListLayout", {FillDirection = Enum.FillDirection.Vertical, Padding = UDim.new(0, 5)}, frame)

    local top = new("Frame", {Size = UDim2.new(1, 0, 0, 12), BackgroundTransparency = 1}, frame)
    lbl(top, name, 9, Color3.fromRGB(170, 170, 170), {
        Size = UDim2.new(0.6, 0, 1, 0), TextXAlignment = LEFT,
    })
    local valLbl = lbl(top, tostring(init), 9, color, {
        Size = UDim2.new(0.4, 0, 1, 0), Position = UDim2.new(0.6, 0, 0, 0), TextXAlignment = RIGHT,
    })

    local track = new("Frame", {
        Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = Color3.fromRGB(38, 38, 38), BorderSizePixel = 0,
    }, frame)
    corner(track, FULL)
    local fill = new("Frame", {BackgroundColor3 = color, BorderSizePixel = 0}, track)
    corner(fill, FULL)
    local thumb = new("TextButton", {
        Size = UDim2.new(0, 16, 0, 16), AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Color3.fromRGB(240, 240, 240), Text = "", BorderSizePixel = 0, ZIndex = 10,
    }, track)
    corner(thumb, FULL)
    local hit = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 22), Position = UDim2.new(0, 0, 0.5, -11),
        BackgroundTransparency = 1, Text = "", ZIndex = 8,
    }, track)

    local s = {onChange = onChange}
    function s.set(raw)
        local v = snap and math.floor(raw / snap) * snap or math.floor(raw)
        v = math.clamp(v, minV, maxV)
        local pct = (v - minV) / (maxV - minV)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        thumb.Position = UDim2.new(pct, 0, 0.5, 0)
        valLbl.Text = tostring(v)
        return v
    end
    function s.fromX(x)
        local w = math.max(track.AbsoluteSize.X, 1)
        return s.set(minV + math.clamp((x - track.AbsolutePosition.X) / w, 0, 1) * (maxV - minV))
    end

    -- Scroll dimatikan selama drag supaya slider tidak ikut menggulung panel di layar sentuh.
    local function startDrag(input)
        local t = input.UserInputType
        if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
            activeSlider = s
            scroll.ScrollingEnabled = false
            onChange(s.fromX(input.Position.X))
        end
    end
    hit.InputBegan:Connect(startDrag)
    thumb.InputBegan:Connect(startDrag)

    s.set(init)
    return s
end


    applyBtn.Text             = "..."
    applyBtn.BackgroundColor3 = Color3.fromRGB(30,30,30)
    applyBtn.TextColor3       = Color3.fromRGB(0,220,110)

    task.spawn(function()
        -- FPS CAP
        local capOk = tryFPSCap(fpsCapValue)
        log("fps cap " .. fpsCapValue .. (capOk and " ✓" or " (no setfpscap)"))

        -- GRAPHICS QUALITY
        pcall(function()
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        end)

        -- HIDDEN PROPS
        tryHidden(Lighting, "Technology", Enum.Technology.Compatibility)
        tryHidden(Lighting, "ShadowSoftness", 0)
        tryHidden(workspace, "MeshPartHeads", false)
        tryHidden(workspace, "StreamingMinRadius", 64)
        tryHidden(workspace, "StreamingTargetRadius", renderDist)

        -- LIGHTING
        if state.shadow then
            log("killing shadows...")
            pcall(function() Lighting.GlobalShadows = false end)
            for _, v in ipairs(Lighting:GetChildren()) do
                pcall(function()
                    if v:IsA("BlurEffect") or v:IsA("ColorCorrectionEffect")
                    or v:IsA("SunRaysEffect") or v:IsA("BloomEffect")
                    or v:IsA("DepthOfFieldEffect") or v:IsA("PostEffect") then
                        v:Destroy()
                    end
                end)
            end
        end

        for _, v in ipairs(Lighting:GetChildren()) do
            pcall(function()
                if v:IsA("Atmosphere") then
                    v.Density=0; v.Glare=0; v.Haze=0; v.Offset=0
                end
            end)
        end

        if state.sky then
            for _, v in ipairs(Lighting:GetChildren()) do
                pcall(function() if v:IsA("Sky") then v:Destroy() end end)
            end
        end

        -- TERRAIN
        pcall(function()
            local t = workspace:FindFirstChildOfClass("Terrain")
            if t then
                t.WaterWaveSize=0; t.WaterWaveSpeed=0
                t.WaterReflectance=0; t.WaterTransparency=0
            end
        end)

        -- WORLD SCAN — batched
        log("scanning world...")
        local list  = workspace:GetDescendants()
        local total = 0
        for i = 1, #list, CFG.batchSize do
            for j = i, math.min(i+CFG.batchSize-1, #list) do
                nukeWorldObject(list[j]); total+=1
            end
            task.wait()
        end

        -- PLAYER OPTIMIZATION
        log("optimizing " .. #Players:GetPlayers() .. " players...")
        setupPlayerOptimization()

        -- RENDER DISTANCE
        log("render dist " .. renderDist .. "...")
        local hidden = applyRenderDistOnce()

        -- START ADAPTIVE
        startAdaptiveSystem(logBox, statusVal)

        -- PLAYER LOD TIMER — tiap 5 detik, lightweight
        task.spawn(function()
            while applied do
                task.wait(5)
                applyPlayerDistanceLOD()
            end
        end)

        task.wait(1)
        applied = true
        local af = currentFPS
        fpsAfterVal.Text       = af.." fps"
        fpsAfterVal.TextColor3 = colorFPS(af)

        log(total.." obj | "..hidden.." hidden ✓")
        statusVal.Text            = "● ACTIVE"
        statusVal.TextColor3      = Color3.fromRGB(0,255,136)
        applyBtn.Text             = "⚡ RE-APPLY"
        applyBtn.BackgroundColor3 = Color3.fromRGB(0,220,110)
        applyBtn.TextColor3       = Color3.fromRGB(0,0,0)
    end)
end)


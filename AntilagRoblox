-- ================================================
-- PLAYER OPTIMIZATION
-- ================================================
local playerOptimized = {}

local leafKW = {
    "leaf","leaves","daun","foliage","tree","pohon","bush","shrub",
    "grass","rumput","plant","tanaman","bark","branch","vine","fern"
}
local function isLeafName(name)
    local low = name:lower()
    for _, k in ipairs(leafKW) do
        if low:find(k,1,true) then return true end
    end
    return false
end

local function optimizeCharacter(char, isLocal)
    if not char then return end
    for _, obj in ipairs(char:GetDescendants()) do
        pcall(function()
            if obj:IsA("SurfaceAppearance") or obj:IsA("MaterialVariant") then
                obj:Destroy()
            elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail")
            or obj:IsA("Beam") or obj:IsA("Fire")
            or obj:IsA("Smoke") or obj:IsA("Sparkles") then
                obj:Destroy()
            elseif obj:IsA("MeshPart") or obj:IsA("Part") then
                obj.Material = Enum.Material.SmoothPlastic
                obj.Reflectance = 0
                obj.CastShadow = false
                if obj:IsA("MeshPart") then obj.TextureID = "" end
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                obj.Transparency = 1
            elseif obj:IsA("PointLight") or obj:IsA("SpotLight")
            or obj:IsA("SurfaceLight") then
                obj.Enabled = false
            elseif obj:IsA("Humanoid") and not isLocal then
                pcall(function()
                    obj:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                    obj:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                    obj:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)
                end)
            end
            -- (sound & overhead nameplate/billboard sengaja TIDAK disentuh biar tetap kedengeran/kelihatan)
        end)
    end
end

local function applyPlayerDistanceLOD()
    local char = lp.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local rp = root.Position
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp and plr.Character then
            local or2 = plr.Character:FindFirstChild("HumanoidRootPart")
            if or2 then
                local dist = (or2.Position - rp).Magnitude
                for _, obj in ipairs(plr.Character:GetDescendants()) do
                    pcall(function()
                        if obj:IsA("Accessory") then
                            local h = obj:FindFirstChild("Handle")
                            if h then
                                h.Transparency = dist > CFG.playerLODDist and 1 or 0
                            end
                        end
                    end)
                end
            end
        end
    end
end

local function setupPlayerOptimization()
    for _, plr in ipairs(Players:GetPlayers()) do
        local isLocal = plr == lp
        local function handleChar(char)
            if playerOptimized[plr.UserId] then return end
            task.wait(0.5)
            optimizeCharacter(char, isLocal)
            playerOptimized[plr.UserId] = true
            trackConn(char.DescendantAdded:Connect(function(obj)
                task.defer(function()
                    pcall(function()
                        if obj:IsA("SurfaceAppearance") or obj:IsA("MaterialVariant") then
                            obj:Destroy()
                        elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail")
                        or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
                            obj:Destroy()
                        elseif obj:IsA("MeshPart") then
                            obj.TextureID = ""
                            obj.Material  = Enum.Material.SmoothPlastic
                            obj.CastShadow = false
                        end
                    end)
                end)
            end))
        end
        if plr.Character then task.spawn(handleChar, plr.Character) end
        trackConn(plr.CharacterAdded:Connect(function(char)
            playerOptimized[plr.UserId] = nil
            task.spawn(handleChar, char)
        end))
    end

    trackConn(Players.PlayerAdded:Connect(function(plr)
        trackConn(plr.CharacterAdded:Connect(function(char)
            playerOptimized[plr.UserId] = nil
            task.spawn(function()
                task.wait(0.5)
                optimizeCharacter(char, plr == lp)
                playerOptimized[plr.UserId] = true
                trackConn(char.DescendantAdded:Connect(function(obj)
                    task.defer(function()
                        pcall(function()
                            if obj:IsA("SurfaceAppearance") or obj:IsA("MaterialVariant") then
                                obj:Destroy()
                            elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail")
                            or obj:IsA("Fire") or obj:IsA("Smoke") then
                                obj:Destroy()
                            elseif obj:IsA("MeshPart") then
                                obj.TextureID  = ""
                                obj.Material   = Enum.Material.SmoothPlastic
                                obj.CastShadow = false
                            end
                        end)
                    end)
                end))
            end)
        end))
    end))

    trackConn(Players.PlayerRemoving:Connect(function(plr)
        playerOptimized[plr.UserId] = nil
    end))
end

-- ================================================
-- ADAPTIVE FPS
-- ================================================
local adaptiveConn = nil
local lastAdaptCheck = 0

local function startAdaptiveSystem(logBox, statusVal)
    if adaptiveConn then pcall(function() adaptiveConn:Disconnect() end) end
    adaptiveConn = RunService.Heartbeat:Connect(function()
        local now = os.clock()
        if now - lastAdaptCheck < 3 then return end
        lastAdaptCheck = now
        local fps = currentFPS
        if fps < CFG.fpsLowThreshold and adaptiveTier < 2 then
            adaptiveTier += 1
            if adaptiveTier == 1 then
                renderDist = math.max(128, renderDist * 0.75)
                logBox.Text = "> adaptive T1: dist->"..renderDist
                task.spawn(function()
                    local c = lp.Character
                    local r = c and c:FindFirstChild("HumanoidRootPart")
                    if not r then return end
                    local rp = r.Position
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        pcall(function()
                            if obj:IsA("BasePart") then
                                local ic = false
                                for _, p in ipairs(Players:GetPlayers()) do
                                    if p.Character and obj:IsDescendantOf(p.Character) then ic=true; break end
                                end
                                if not ic and (obj.Position-rp).Magnitude > renderDist then
                                    obj.Transparency = 1
                                end
                            end
                        end)
                    end
                end)
            elseif adaptiveTier == 2 then
                logBox.Text = "> adaptive T2: max reduction"
                task.spawn(function()
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        pcall(function()
                            if obj:IsA("PointLight") or obj:IsA("SpotLight")
                            or obj:IsA("SurfaceLight") then obj.Enabled = false
                            end
                        end)
                    end
                    if HAS_SETFPSCAP then pcall(setfpscap, 30) end
                    applyPlayerDistanceLOD()
                end)
            end
            statusVal.Text       = "● ADAPTIVE T"..adaptiveTier
            statusVal.TextColor3 = Color3.fromRGB(255,180,0)
        elseif fps >= 50 and adaptiveTier > 0 then
            adaptiveTier = 0
            statusVal.Text       = "● ACTIVE"
            statusVal.TextColor3 = Color3.fromRGB(0,255,136)
        end
    end)
    trackConn(adaptiveConn)
end

-- ================================================
-- WORLD NUKE
-- ================================================
local function nukeWorldObject(obj)
    pcall(function()
        if obj:IsA("SurfaceAppearance") or obj:IsA("MaterialVariant") then
            obj:Destroy(); return
        end
        if obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
            obj.Enabled = false; return
        end
        if obj:IsA("SpringConstraint") or obj:IsA("RopeConstraint")
        or obj:IsA("RodConstraint")    or obj:IsA("HingeConstraint")
        or obj:IsA("BallSocketConstraint") or obj:IsA("PrismaticConstraint")
        or obj:IsA("BodyVelocity")     or obj:IsA("BodyPosition")
        or obj:IsA("BodyForce")        or obj:IsA("BodyGyro") then
            local ic = false
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Character and obj:IsDescendantOf(p.Character) then ic=true; break end
            end
            if not ic then obj:Destroy() end; return
        end
        if obj:IsA("SelectionBox") or obj:IsA("SelectionSphere") then
            obj:Destroy(); return
        end
        if obj:IsA("ClickDetector") then
            obj.MaxActivationDistance = 0; return
        end
        if obj:IsA("SurfaceGui") then
            local ic = false
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Character and obj:IsDescendantOf(p.Character) then ic=true; break end
            end
            if not ic then obj.Enabled = false end; return
        end
        -- overhead (BillboardGui: nametag/healthbar/chat) & Sound sengaja dibiarkan hidup
        if obj:IsA("BillboardGui") or obj:IsA("Sound") then
            return
        end
        if obj:IsA("MeshPart") then
            if state.texture then obj.TextureID=""; obj.Material=Enum.Material.SmoothPlastic; obj.Reflectance=0 end
            if state.shadow then obj.CastShadow=false end; return
        end
        if obj:IsA("SpecialMesh") then
            if state.texture then obj.TextureId="" end; return
        end
        if obj:IsA("BasePart") then
            local ic = false
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Character and obj:IsDescendantOf(p.Character) then ic=true; break end
            end
            if ic then return end
            if state.texture then obj.Material=Enum.Material.SmoothPlastic; obj.Reflectance=0 end
            if state.shadow then obj.CastShadow=false end
            if state.leaf and isLeafName(obj.Name) then
                obj.Transparency=1; obj.CanCollide=false; obj.CastShadow=false; return
            end
            if state.anchor then
                obj.Anchored=true
                pcall(function() obj:SetNetworkOwner(nil) end)
            end; return
        end
        if obj:IsA("Decal") or obj:IsA("Texture") then
            if state.texture then obj.Transparency=1 end; return
        end
        if state.fx and (obj:IsA("ParticleEmitter") or obj:IsA("Fire") or
            obj:IsA("Smoke") or obj:IsA("Sparkles") or
            obj:IsA("Trail") or obj:IsA("Beam")) then
            local ic=false
            for _,p in ipairs(Players:GetPlayers()) do
                if p.Character and obj:IsDescendantOf(p.Character) then ic=true; break end
            end
            if not ic then obj:Destroy() end
        end
    end)
end

local function applyRenderDistOnce()
    local char = lp.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return 0 end
    local rp, n = root.Position, 0
    for _, obj in ipairs(workspace:GetDescendants()) do
        pcall(function()
            if obj:IsA("BasePart") then
                local ic=false
                for _,p in ipairs(Players:GetPlayers()) do
                    if p.Character and obj:IsDescendantOf(p.Character) then ic=true; break end
                end
                if not ic and (obj.Position-rp).Magnitude > renderDist then
                    obj.Transparency=1; n+=1
                end
            end
        end)
    end
    return n
end


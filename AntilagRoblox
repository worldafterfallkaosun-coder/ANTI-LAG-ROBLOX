applyBtn.MouseButton1Click:Connect(function()
    statusVal.Text = "● RUNNING"
    statusVal.TextColor3 = Color3.fromRGB(255, 180, 0)
    applyBtn.Text = "..."
    applyBtn.BackgroundColor3 = Color3.fromRGB(30,30,30)
    applyBtn.TextColor3 = Color3.fromRGB(0,220,110)

    task.spawn(function()

        -- LIGHTING
        if state.shadow then
            log("killing shadows...")
            Lighting.GlobalShadows = false
            for _, v in pairs(Lighting:GetChildren()) do
                pcall(function()
                    if v:IsA("BlurEffect") or v:IsA("ColorCorrectionEffect")
                    or v:IsA("SunRaysEffect") or v:IsA("BloomEffect")
                    or v:IsA("DepthOfFieldEffect") or v:IsA("PostEffect") then
                        v:Destroy()
                    end
                end)
            end
        end

        -- ATMOSPHERE
        for _, v in pairs(Lighting:GetChildren()) do
            pcall(function()
                if v:IsA("Atmosphere") then
                    v.Density = 0; v.Glare = 0; v.Haze = 0
                end
            end)
        end

        -- SKY
        if state.sky then
            log("killing skybox...")
            for _, v in pairs(Lighting:GetChildren()) do
                pcall(function()
                    if v:IsA("Sky") then v:Destroy() end
                end)
            end
        end

        -- TERRAIN (safe with pcall, fixes Decoration error)
        pcall(function()
            local terrain = workspace:FindFirstChildOfClass("Terrain")
            if terrain then
                terrain.WaterWaveSize = 0
                terrain.WaterWaveSpeed = 0
                terrain.WaterReflectance = 0
                -- Decoration removed from API, skip it
            end
        end)

        -- PARTS — FULL SCAN
        log("scanning parts...")
        local count = 0

        for _, obj in pairs(workspace:GetDescendants()) do
            pcall(function()

                -- TEXTURE NUKE (fixed)
                if state.texture then
                    nukePartTexture(obj)
                end

                if obj:IsA("BasePart") then
                    -- SHADOW
                    if state.shadow then
                        obj.CastShadow = false
                    end

                    -- LEAF
                    if state.leaf and isLeaf(obj.Name) then
                        obj.Transparency = 1
                        obj.CanCollide = false
                        obj.CastShadow = false
                    end

                    -- ANCHOR
                    if state.anchor then
                        local isChar = false
                        for _, p in pairs(Players:GetPlayers()) do
                            if p.Character and obj:IsDescendantOf(p.Character) then
                                isChar = true; break
                            end
                        end
                        if not isChar then obj.Anchored = true end
                    end

                    count += 1
                end

                -- FX NUKE
                if state.fx then
                    if obj:IsA("ParticleEmitter") or obj:IsA("Fire")
                    or obj:IsA("Smoke") or obj:IsA("Sparkles")
                    or obj:IsA("Trail") or obj:IsA("Beam") then
                        obj:Destroy()
                    end
                end

            end) -- pcall end
        end

        task.wait(0.2)

        -- RENDER DISTANCE
        log("setting render dist " .. renderDist .. "...")
        applyRenderDistance(renderDist)

        task.wait(0.3)
        log(count .. " parts processed ✓")
        statusVal.Text = "● ACTIVE"
        statusVal.TextColor3 = Color3.fromRGB(0,255,136)
        applyBtn.Text = "⚡ APPLY NUKE"
        applyBtn.BackgroundColor3 = Color3.fromRGB(0,220,110)
        applyBtn.TextColor3 = Color3.fromRGB(0,0,0)
    end)
end)

